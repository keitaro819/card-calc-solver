# GEMINI_API_KEY: Optional. Used only for screenshot image recognition via Gemini Vision.
# Not required if numbers are entered manually.
GEMINI_API_KEY=

# GEMINI_MODEL: Optional. Specify the Gemini model to use (default: gemini-flash-latest).
# Supported examples: gemini-flash-latest, gemini-3.1-flash-lite, gemini-3.8-flash
GEMINI_MODEL=
